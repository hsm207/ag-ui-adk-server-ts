{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowImportingTsExtensions": false,
    "verbatimModuleSyntax": true,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,

    /* ── Strictness: correctness tier ───────────────────────────── */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedSideEffectImports": true,
    "forceConsistentCasingInFileNames": true,
    "allowUnreachableCode": false,

    /* ── Strictness: hygiene tier ───────────────────────────────── */
    "noPropertyAccessFromIndexSignature": true

    /* skipLibCheck: the ADK .d.ts references peer deps we do not
       install (MCP SDK, Cloud Storage); full lib checking produces
       only third-party noise. Our code stays fully checked. */
  },
  "include": ["src"],
  "exclude": ["dist", "tests"]
}
